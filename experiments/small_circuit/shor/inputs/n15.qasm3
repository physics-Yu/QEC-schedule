// C-MARGINAL ONLY: A tail removed; final A is not a binary residue.
OPENQASM 3.0;
include "stdgates.inc";
// E[j] = q[n+j]; E[t-1-r] -> b[r]; c = sum(2^r b[r]).
// All measurements follow the whole unitary; fixed bit wiring is NOT feedback.
// N=15, g=2, A=1 specialization; coherent inverse QFT; no feedback
// q[0] is A LSB; b[0] is c_out LSB. All E readouts may be simultaneous.
qubit[12] q;
bit[8] b;
reset q[0];
reset q[1];
reset q[2];
reset q[3];
reset q[4];
reset q[5];
reset q[6];
reset q[7];
reset q[8];
reset q[9];
reset q[10];
reset q[11];
x q[0];
h q[4];
h q[5];
h q[6];
h q[7];
h q[8];
h q[9];
h q[10];
h q[0];
cz q[5], q[0];
h q[2];
cz q[5], q[2];
h q[2];
cz q[2], q[3];
h q[3];
tdg q[3];
h q[3];
cz q[4], q[3];
h q[3];
t q[3];
h q[3];
cz q[2], q[3];
h q[3];
tdg q[3];
h q[3];
cz q[4], q[3];
h q[3];
t q[2];
t q[3];
h q[3];
h q[2];
cz q[4], q[2];
h q[2];
t q[4];
tdg q[2];
h q[2];
cz q[4], q[2];
cz q[3], q[2];
h q[2];
h q[1];
cz q[4], q[1];
cp(-1*pi/2) q[11], q[10];
cp(-1*pi/4) q[11], q[9];
cp(-1*pi/8) q[11], q[8];
cp(-1*pi/16) q[11], q[7];
cp(-1*pi/32) q[11], q[6];
cp(-1*pi/64) q[11], q[5];
cp(-1*pi/128) q[11], q[4];
h q[10];
cp(-1*pi/2) q[10], q[9];
cp(-1*pi/4) q[10], q[8];
cp(-1*pi/8) q[10], q[7];
cp(-1*pi/16) q[10], q[6];
cp(-1*pi/32) q[10], q[5];
cp(-1*pi/64) q[10], q[4];
h q[9];
cp(-1*pi/2) q[9], q[8];
cp(-1*pi/4) q[9], q[7];
cp(-1*pi/8) q[9], q[6];
cp(-1*pi/16) q[9], q[5];
cp(-1*pi/32) q[9], q[4];
h q[8];
cp(-1*pi/2) q[8], q[7];
cp(-1*pi/4) q[8], q[6];
cp(-1*pi/8) q[8], q[5];
cp(-1*pi/16) q[8], q[4];
h q[7];
cp(-1*pi/2) q[7], q[6];
cp(-1*pi/4) q[7], q[5];
cp(-1*pi/8) q[7], q[4];
h q[6];
cp(-1*pi/2) q[6], q[5];
cp(-1*pi/4) q[6], q[4];
h q[5];
cp(-1*pi/2) q[5], q[4];
h q[4];
// Global readout fence: complete every unitary before any measurement.
barrier q;
b[0] = measure q[11];
b[1] = measure q[10];
b[2] = measure q[9];
b[3] = measure q[8];
b[4] = measure q[7];
b[5] = measure q[6];
b[6] = measure q[5];
b[7] = measure q[4];
