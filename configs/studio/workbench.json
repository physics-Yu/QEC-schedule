{
  "algorithms": [
    {
      "id": "ordered_greedy",
      "label": "有序轴贪心 · 当前版",
      "defaults": {
        "beam_width": 64,
        "plan_budget": 4,
        "route_budget": 128,
        "compile_timeout_s": 300,
        "solver_timeout_ms": 5000,
        "model_budget": 24,
        "readout_candidate_budget": 16,
        "readout_top_k": 3
      }
    },
    {
      "id": "smt_ordered",
      "label": "SMT 有序轴批次 · 当前版",
      "defaults": {
        "beam_width": 64,
        "plan_budget": 4,
        "route_budget": 128,
        "compile_timeout_s": 300,
        "solver_timeout_ms": 5000,
        "model_budget": 24,
        "readout_candidate_budget": 16,
        "readout_top_k": 3
      }
    },
    {
      "id": "greedy",
      "label": "贪心并行与运输",
      "defaults": {
        "ready_limit": 16,
        "site_limit": 4
      }
    },
    {
      "id": "critical_path",
      "label": "关键路径优先",
      "defaults": {
        "ready_limit": 16,
        "site_limit": 4
      }
    },
    {
      "id": "lookahead",
      "label": "有限前瞻与复用",
      "defaults": {
        "ready_limit": 16,
        "site_limit": 4,
        "lookahead_depth": 2,
        "beam_width": 3,
        "rollout_budget": 12
      }
    },
    {
      "id": "basic",
      "label": "逐门归还基线",
      "defaults": {
        "ready_limit": 16,
        "site_limit": 4
      }
    },
    {
      "id": "returning",
      "label": "单原子搬运 · 每门归还",
      "single_trap": true,
      "defaults": {}
    },
    {
      "id": "resident",
      "label": "单原子搬运 · 驻留复用",
      "single_trap": true,
      "defaults": {}
    }
  ],
  "demos": [
    {
      "id": "parallel-h",
      "label": "四原子 H 并行",
      "note": "4 个同类型门；短流程，可快速编译验收。",
      "input_file": "demos/parallel-h.json"
    },
    {
      "id": "ordered-qec-ghz2",
      "label": "两逻辑 QEC · 当前有序轴与测量策略",
      "note": "34 原子；有序轴贪心、axis-hold、AOD/SLM 测量目标比较；固定完整协议。",
      "input_file": "demos/ordered-qec-ghz2.json"
    },
    {
      "id": "surface-ghz",
      "label": "四逻辑 GHZ · 酉编码",
      "note": "36 data；二维布局与专用 patch 调度，无稳定子测量。",
      "input_file": "demos/surface-ghz.json"
    },
    {
      "id": "surface-qec-ghz2",
      "label": "两逻辑 GHZ · 单轮 QEC",
      "note": "18 data + 16 ancilla；配套读出、反馈及专用调度。",
      "input_file": "demos/surface-qec-ghz2.json"
    },
    {
      "id": "surface-qec-temporal",
      "label": "两逻辑 GHZ · 多轮 QEC",
      "note": "34 原子；受限单事件报告噪声与闭合轮，编译较长。",
      "input_file": "demos/surface-qec-temporal.json"
    },
    {
      "id": "surface-qec-temporal-four",
      "label": "四逻辑 GHZ · 多轮 QEC",
      "note": "68 原子；完整配套协议，编译可能需要数十分钟。",
      "input_file": "demos/surface-qec-temporal-four.json"
    }
  ],
  "architecture": "row_column_orthogonal",
  "coordinate_mode": "relative_offsets",
  "schema": "atom-studio-catalog/v1",
  "compilation_defaults": {
    "max_decisions": 10000
  },
  "default_algorithm": "ordered_greedy",
  "default_circuit": "parallel1q",
  "workspace_defaults": {
    "studio": {
      "mode": "custom"
    },
    "circuit_profile": "physical",
    "atom_count": 4,
    "layout": "grid",
    "seed": 7,
    "anchor_order": "forward",
    "ez_policy": "adaptive",
    "aod_rows": 2,
    "aod_columns": 2,
    "aod_row_offsets_um": [
      0,
      10
    ],
    "aod_column_offsets_um": [
      0,
      10
    ],
    "ez_neighbor_guard_enabled": true,
    "aod_backend": "row_column_orthogonal"
  },
  "circuit_presets": [
    {
      "id": "nonuniform_pairs",
      "label": "非均匀 CZ 配对（至少 6 原子；仅替换电路）"
    },
    {
      "id": "parallel1q",
      "label": "全部原子并行 H"
    },
    {
      "id": "ghz",
      "label": "物理比特 GHZ（H / CZ 分解）"
    },
    {
      "id": "chain",
      "label": "CZ 链"
    },
    {
      "id": "mixed",
      "label": "H / CZ / T 混合"
    },
    {
      "id": "rotations",
      "label": "全部原子 T"
    },
    {
      "id": "empty",
      "label": "空线路"
    }
  ]
}
